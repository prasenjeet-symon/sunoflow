<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Versioned Windows TFM: carries a Win10 2004 (build 19041) SDK contract,
         which makes the WinRT projection (Windows.Media.Ocr, Windows.Graphics.Imaging,
         Windows.Foundation) available in-box — no NuGet package. Needed for the
         screen-context OCR feature (ScreenContext.cs). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Pin to x64: the target is modern Windows GPUs (all 64-bit). Pinning the
         platform means the SendInput INPUT-union's x64 layout (FieldOffset(8))
         is unambiguous and the marshal size is the expected 40 bytes. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Matches the PerMonitorV2 declaration in app.manifest, so the generated
         ApplicationConfiguration.Initialize() does not ask for a different mode
         than the manifest already committed the process to. The dashboard is
         drawn in device-independent units and relies on WinForms scaling them. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- The brand mark, so Explorer, the taskbar and Alt-Tab show the ear. -->
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <AssemblyName>SunoFlow</AssemblyName>
    <RootNamespace>SunoFlow</RootNamespace>
    <Version>1.0.0</Version>
    <Company>SunoFlow</Company>
    <Product>SunoFlow</Product>
    <Description>On-device voice dictation for Windows. Talk to your computer and it types for you.</Description>
    <!-- No console window when launched from Explorer. -->
    <DisableWinExeOutputCheck>false</DisableWinExeOutputCheck>
  </PropertyGroup>

  <ItemGroup>
    <!-- NAudio: mic capture + WAV writing. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- DPAPI (ProtectedData) is not in the box on .NET 8; it ships as this
         Microsoft package. Used by AccountManager to encrypt the device key at
         rest under the current Windows user. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- Tray icons: the brand mark (an ear receiving sound) per state, mirroring
       the macOS menu bar. Regenerate with `node tools\make-icons.js`. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\tray-idle.ico" />
    <EmbeddedResource Include="Assets\tray-recording.ico" />
    <EmbeddedResource Include="Assets\tray-offline.ico" />
    <EmbeddedResource Include="Assets\tray-processing.ico" />
    <EmbeddedResource Include="Assets\app-icon.ico" />
  </ItemGroup>

</Project>