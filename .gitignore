# ── macOS ───────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# ── Logs ─────────────────────────────────────────────────
*.log
app-debug.log
app-launchd.log
sidecar.log

# ── Python (sidecars) ────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/
venv/
env/
.pytest_cache/

# Downloaded STT model weights (~2.5GB) — user data, never commit
sidecar/model/
sidecars/*/model/

# Sidecar runtime state — these are user data, not source
sidecar/config.json
sidecar/corrections.json
sidecars/*/corrections.json

# PyInstaller build output (frozen sidecars)
sidecar/.venv-build/
sidecar/build/
sidecar/dist/
sidecars/windows/.venv-build/
sidecars/windows/build/
sidecars/windows/dist/

# ── Swift build artifacts ───────────────────────────────
SunoFlowApp/.build/
SunoFlowApp/SunoFlow.app
SunoFlowApp/signing/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/

# ── Release output (release.sh) ────────────────────────
*.dmg
SunoFlow.app.zip

# ── .NET (Windows tray app) ────────────────────────────
apps/windows/SunoFlow/bin/
apps/windows/SunoFlow/obj/
apps/windows/SunoFlow/.vs/

# Windows installer staging + output (built by .github/workflows/release.yml)
apps/windows/installer/stage/
apps/windows/installer/output/

# ── Secrets / signing keys ──────────────────────────────
*.p12
*.cer
*.certSigningRequest
*.pem

# ── Editor / IDE ────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Local project memory (not for distribution) ─────────
.ogcode/
MEMORY.md
# Firebase Functions dependencies
functions/node_modules/

# Local emulator secrets — never commit
functions/.secret.local

# Firebase CLI deploy cache — machine-local, regenerated on every deploy
.firebase/

# Dictation smoke test droppings — the downloaded model and the run's lease.
# The WAV fixture it transcribes IS committed (sidecars/testdata/).
model-cache/
dictation-smoke-lease.json
