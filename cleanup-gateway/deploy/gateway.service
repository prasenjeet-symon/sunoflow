# SunoFlow cleanup gateway — systemd unit
#
# Install at /etc/systemd/system/sunoflow-gateway.service, then:
#   systemctl daemon-reload
#   systemctl enable --now sunoflow-gateway
#
# The binary is a single static artifact. Adjust ExecStart path as needed.
# Environment is loaded from /etc/sunoflow/gateway.env (EnvironmentFile).

[Unit]
Description=SunoFlow cleanup gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sunoflow
Group=sunoflow
ExecStart=/usr/local/bin/sunoflow-gateway
EnvironmentFile=/etc/sunoflow/gateway.env
# FIREBASE_CREDENTIALS points at a service-account JSON; it must be readable by
# User= above and by nothing else. ReadWritePaths is not needed — it is only read.
Restart=on-failure
RestartSec=2

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/sunoflow-gateway
# Cleanup calls the Gemini API, so outbound HTTPS is required.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target