# SunoFlow cleanup gateway — local / docker-compose env
# Copy to `.env` and fill in. `.env` is gitignored.

# REQUIRED — guards all /admin/* endpoints. Use a long random secret.
ADMIN_TOKEN=change-me-to-a-long-random-secret

# Per-key quotas (defaults shown)
DEFAULT_QUOTA_RPM=60
DEFAULT_QUOTA_DAILY=5000

# Logging: debug | info | warn | error
LOG_LEVEL=info

# --- LLM backend -------------------------------------------------------------
# Gemini is the only backend. Cleanup is mechanical transcript tidying, so the
# flash-lite class with thinking at its floor is the right trade: reasoning
# models spend 6-24s emitting chain-of-thought before answering, which lands
# directly on the dictation latency the user feels.
BACKEND=gemini

# REQUIRED. Get one from https://aistudio.google.com/apikey (an AI Studio key
# starts with "AIza"). Never commit this. The gateway refuses to start without
# it rather than silently degrading every cleanup to raw text.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=20s
# How hard the model may reason before answering: minimal|low|medium|high.
# Empty omits the field (needed for older 2.5-era models that want an int budget).
GEMINI_THINKING_LEVEL=low

# --- Account entitlement (Firestore) -----------------------------------------
# Turns on trial/subscription enforcement. The gateway resolves each device key
# to its account and refuses cleanup for an expired trial or a lapsed
# subscription. Leave FIREBASE_PROJECT empty and NOTHING is enforced — the
# gateway falls back to its own key table and any valid key is served.
FIREBASE_PROJECT=sunoflow-app

# Path to a service-account JSON with Firestore read/write ("Cloud Datastore
# User" is enough). Keep it outside the repo, readable only by the gateway user:
#   sudo install -o sunoflow -g sunoflow -m 400 key.json /etc/sunoflow/firebase.json
# Leave empty to use Application Default Credentials instead (e.g. on GCP).
FIREBASE_CREDENTIALS=/etc/sunoflow/firebase.json

# Signing key for the offline entitlement leases handed to entitled devices.
# A lease bounds how long a sidecar keeps working while it cannot reach this
# gateway (72h), so that blocking the hostname is no longer unlimited free
# dictation. Leave EMPTY: the built-in default is the value every shipped
# sidecar verifies against. Setting a custom one WITHOUT shipping a matching
# sidecar build invalidates every lease in the field — see deploy/ENTITLEMENT.md.
LEASE_SECRET=

# --- Product analytics (PostHog) ---------------------------------------------
# Empty = off. Nothing is sent anywhere and no events are collected, which is the
# right setting for a local or self-hosted run.
#
# This is the ingest (project) key, the write-only one — not a personal API key.
# Counts and platform only: no transcript, no cleaned text, no screen OCR, no
# cursor context, no dictionary, no IP.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- Cloud STT (warm-start dictation path) -----------------------------------
# POST /stt transcribes audio in the cloud so a new install can dictate
# immediately while its local model (~2GB Mac / ~600MB Win) downloads in the
# background; the sidecar then validates the local model and cuts over, and stops
# calling here.
#
# Defaults to groq. It activates once STT_API_KEY is set; with no key the /stt
# route soft-disables (answers 501, logs a warning) and the gateway still boots
# normally — so a deployment that never sets an STT key is unaffected. Set
# STT_PROVIDER= (empty) to disable STT explicitly.
#
#   groq   — dedicated Whisper (OpenAI-compatible /audio/transcriptions): the
#            default. Measured ~3-4x faster than the alternatives (~0.3-0.6s vs
#            ~2s) and more accurate. Key from https://console.groq.com/keys.
#   openrouter — audio sent to an audio-capable model via OpenRouter's
#            OpenAI-compatible chat endpoint. One key covers STT + any model swap
#            (default Mistral Voxtral), but ~3-4x slower. Key from
#            https://openrouter.ai/keys.
#   gemini — reuses GEMINI_API_KEY, no new credential; transcribes through the
#            same flash-lite class as cleanup.
STT_PROVIDER=groq
# Required for groq/openrouter. Ignored for gemini (reuses GEMINI_API_KEY). With
# no key, STT soft-disables and the gateway still starts.
STT_API_KEY=
# Model. Empty falls back per provider: whisper-large-v3-turbo (groq),
# mistralai/voxtral-small-24b-2507 (openrouter), or GEMINI_MODEL (gemini).
STT_MODEL=
# API root. Empty falls back per provider: https://api.groq.com/openai/v1 (groq),
# https://openrouter.ai/api/v1 (openrouter), or GEMINI_URL (gemini).
STT_BASE_URL=
# Optional BCP-47 language hint (e.g. "en"). Empty auto-detects — the right
# default for a multilingual user base.
STT_LANGUAGE=
STT_TIMEOUT=30s
# Own quota ledger, separate from cleanup and answer. The ceiling bounds cloud
# cost for a device that never manages to cut over to local (stalled download).
STT_QUOTA_RPM=15
STT_QUOTA_DAILY=300
STT_HARD_DAILY=600

# --- Suno Answer -------------------------------------------------------------
# Gemini media-resolution bucket for the answer screenshot, which FIXES the
# per-image token cost on Gemini 3 (not the pixel size the client uploads):
# MEDIA_RESOLUTION_LOW (~280) / MEDIUM (~560) / HIGH (~1120) / ULTRA_HIGH (~2240).
# The model default is HIGH; we default to MEDIUM to halve image tokens per turn
# (the screenshot rides every turn) while staying legible for typical UI. Set to
# MEDIA_RESOLUTION_HIGH for dense-text/OCR screenshots, or LOW to save more.
ANSWER_MEDIA_RESOLUTION=MEDIA_RESOLUTION_MEDIUM
