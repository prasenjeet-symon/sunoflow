# SunoFlow cleanup gateway — local / docker-compose env
# Copy to `.env` and fill in. `.env` is gitignored.

# REQUIRED — guards all /admin/* endpoints. Use a long random secret.
ADMIN_TOKEN=change-me-to-a-long-random-secret

# Ollama model used for cleanup. Server-controlled: change here and
# `docker compose up -d` to swap models without a client release.
# Local dev reuses the host Ollama, which already has glm-5.2 pulled.
OLLAMA_MODEL=glm-5.2:cloud

# Per-key quotas (defaults shown)
DEFAULT_QUOTA_RPM=60
DEFAULT_QUOTA_DAILY=5000

# Logging: debug | info | warn | error
LOG_LEVEL=info
# --- Backend selection: ollama | gemini ---------------------------------------
# Gemini is the low-latency option: the Ollama cloud tags are all large
# reasoning models that emit chain-of-thought before answering, which costs
# 6-24s per cleanup. Gemini flash-lite with thinking disabled avoids that.
BACKEND=ollama

# Required when BACKEND=gemini. Get one from https://aistudio.google.com/apikey
# (an AI Studio key starts with "AIza"). Never commit this.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=20s
# How hard the model may reason before answering: minimal|low|medium|high.
# Cleanup is mechanical, so the floor is right — reasoning is pure latency.
# Empty omits the field (needed for older 2.5-era models that want an int budget).
GEMINI_THINKING_LEVEL=low
